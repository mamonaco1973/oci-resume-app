<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0"/>
  <meta http-equiv="Pragma" content="no-cache"/>
  <meta http-equiv="Expires" content="0"/>
  <title>Notes Demo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      background: #0f172a;
      color: #e5e7eb;
    }

    header {
      padding: 16px;
      background: #020617;
      border-bottom: 1px solid #1e293b;
    }

    h1 { margin: 0; font-size: 18px; }

    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 16px;
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 16px;
    }

    @media (max-width: 900px) {
      main { grid-template-columns: 1fr; }
    }

    section {
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 12px;
    }

    button {
      padding: 8px 10px;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      background: #2563eb;
      color: white;
      font-size: 13px;
    }

    button.secondary { background: #475569; }
    button.delete { background: #dc2626; }

    input, textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 8px;
      margin-bottom: 8px;
      border-radius: 4px;
      border: 1px solid #1e293b;
      background: #020617;
      color: #e5e7eb;
      font-size: 13px;
    }

    textarea { min-height: 180px; }

    .note {
      padding: 8px;
      border-bottom: 1px solid #1e293b;
      cursor: pointer;
    }

    .note:hover { background: #020617; }
    .note.active { background: #1e293b; }

    .status {
      margin-top: 8px;
      font-size: 12px;
      color: #94a3b8;
      white-space: pre-wrap;
    }

    /* ===================== Modal ===================== */

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.65);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .modal {
      width: 100%;
      max-width: 520px;
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 14px;
    }

    .modal-header {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
    }

    .modal-body { margin-top: 12px; }

    .modal-footer {
      margin-top: 12px;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    /* ===================== Auth chooser modal ===================== */

    .auth-modal {
      max-width: 380px;
      padding: 28px 26px 20px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    .auth-modal .brand {
      width: 44px;
      height: 44px;
      margin: 0 auto 14px;
      border-radius: 10px;
      background: linear-gradient(135deg, #2563eb, #1e40af);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .auth-modal h2 {
      margin: 0 0 6px;
      font-size: 20px;
      font-weight: 600;
      color: #f1f5f9;
    }

    .auth-modal p.sub {
      margin: 0 0 22px;
      font-size: 13px;
      line-height: 1.5;
      color: #94a3b8;
    }

    .auth-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .auth-actions button {
      width: 100%;
      padding: 12px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
    }

    .btn-primary-lg {
      background: #2563eb;
      color: #fff;
      border: none;
    }
    .btn-primary-lg:hover { background: #1d4ed8; }

    .btn-outline-lg {
      background: transparent;
      color: #e5e7eb;
      border: 1px solid #334155;
    }
    .btn-outline-lg:hover { background: #1e293b; }

    .auth-cancel {
      margin-top: 16px;
      background: none;
      border: none;
      color: #64748b;
      font-size: 13px;
      cursor: pointer;
      padding: 4px;
    }
    .auth-cancel:hover { color: #94a3b8; }

    /* ===================== Busy State ===================== */

    .busy-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }

    .busy-overlay.active { display: flex; cursor: wait; }

    .busy-box {
      padding: 16px 18px;
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 10px;
      font-size: 13px;
      color: #e5e7eb;
    }

    body.busy { cursor: wait; }

    body.busy button,
    body.busy input,
    body.busy textarea {
      pointer-events: none;
      opacity: 0.6;
    }
  </style>
</head>

<body>

<header>
  <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <h1>Notes Demo</h1>
    <div style="display:flex; gap:8px;">
      <button id="btnLogin" class="secondary">Sign in</button>
      <button id="btnLogout" class="secondary" style="display:none;">Sign out</button>
    </div>
  </div>
</header>

<main>

  <!-- Notes list -->
  <section>
    <div style="display:flex; gap:8px; margin-bottom:10px;">
      <button id="btnRefresh" class="secondary">Refresh</button>
      <button id="btnNew">New</button>
    </div>
    <div id="notes"></div>
    <div id="listStatus" class="status"></div>
  </section>

  <!-- Editor -->
  <section>
    <input id="title" placeholder="Title (required)" />
    <textarea id="note" placeholder="Note (optional)"></textarea>

    <div style="display:flex; gap:8px;">
      <button id="btnSave">Save</button>
      <button id="btnDelete" class="delete">Delete</button>
    </div>

    <div id="status" class="status"></div>
  </section>

</main>

<!-- ===================== New Note Modal ===================== -->

<div id="newModal" class="modal-backdrop">
  <div class="modal">
    <div class="modal-header">
      <div>New Note</div>
      <div style="flex:1;"></div>
      <button id="btnModalCancel" class="secondary">Cancel</button>
    </div>

    <div class="modal-body">
      <input id="modalTitle" placeholder="Title (required)" />
      <textarea id="modalNote" placeholder="Optional note"></textarea>
      <div id="modalStatus" class="status"></div>
    </div>

    <div class="modal-footer">
      <button id="btnModalCreate">Create</button>
    </div>
  </div>
</div>

<!-- ===================== Auth Chooser Modal ===================== -->

<div id="authModal" class="modal-backdrop">
  <div class="modal auth-modal">
    <div class="brand">📝</div>
    <h2>Welcome to Notes</h2>
    <p class="sub">Sign in to your account, or create a new one to get started.</p>

    <div class="auth-actions">
      <button id="authSignIn" class="btn-primary-lg">Sign In</button>
      <button id="authCreate" class="btn-outline-lg">Create Account</button>
    </div>

    <button id="authCancel" class="auth-cancel">Cancel</button>
  </div>
</div>

<!-- Busy Overlay -->
<div id="busyOverlay" class="busy-overlay">
  <div class="busy-box">Working…</div>
</div>

<!-- Background cold-start probe readout (bottom-right, unobtrusive) -->
<div id="probe" style="position:fixed; bottom:8px; right:10px; font-size:11px;
     color:#64748b; font-family:ui-monospace,Menlo,Consolas,monospace;
     z-index:500;"></div>

<script>
  // ===================== Config =====================
  const API_BASE_URL = "${API_BASE}";

  // Background probe cadence — GET /notes once a minute to keep a Function warm
  // and measure whether that interval is enough to dodge cold starts.
  const PROBE_INTERVAL_MS = 60000;

  // Identity Domains runtime config loaded from /config.json.
  let AUTH = null;

  async function loadAuthConfig() {
    // Relative path — OCI Object Storage serves this page under a long
    // /n/{ns}/b/{bucket}/o/ prefix, so an absolute "/config.json" would 404.
    const res = await fetch("config.json", { cache: "no-store" });
    if (!res.ok) throw new Error("Failed to load /config.json (" + res.status + ")");
    AUTH = await res.json();
    if (!AUTH.domainUrl || !AUTH.clientId || !AUTH.redirectUri) {
      throw new Error("config.json missing domainUrl/clientId/redirectUri");
    }
  }

  // ===================== Auth State =====================
  // The ID token is the credential sent to the API Gateway (aud = client_id).
  function isAuthenticated() {
    return !!sessionStorage.getItem("id_token");
  }

  function updateAuthButtons() {
    const loggedIn = isAuthenticated();
    document.getElementById("btnLogin").style.display  = loggedIn ? "none" : "inline-block";
    document.getElementById("btnLogout").style.display = loggedIn ? "inline-block" : "none";
  }

  function setUiEnabled(enabled) {
    const selectors = [
      "#btnRefresh", "#btnNew", "#btnSave", "#btnDelete",
      "#title", "#note",
      "#modalTitle", "#modalNote",
      "#btnModalCancel", "#btnModalCreate"
    ];
    selectors.forEach(sel => {
      const el = document.querySelector(sel);
      if (el) el.disabled = !enabled;
    });
    document.getElementById("notes").style.pointerEvents = enabled ? "auto" : "none";
    document.getElementById("notes").style.opacity = enabled ? "1" : "0.6";
  }

  // ===================== OAuth / PKCE =====================
  function base64UrlEncode(bytes) {
    let bin = "";
    const arr = new Uint8Array(bytes);
    for (let i = 0; i < arr.length; i++) bin += String.fromCharCode(arr[i]);
    return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
  }

  async function sha256(str) {
    const enc  = new TextEncoder().encode(str);
    const hash = await crypto.subtle.digest("SHA-256", enc);
    return new Uint8Array(hash);
  }

  function randomString(len = 64) {
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
    const bytes = new Uint8Array(len);
    crypto.getRandomValues(bytes);
    let out = "";
    for (let i = 0; i < bytes.length; i++) out += chars[bytes[i] % chars.length];
    return out;
  }

  function authBase() {
    return AUTH.domainUrl.replace(/\/$/, "");
  }

  async function startLogin() {
    if (!AUTH) { setListStatus("Auth config not loaded yet."); return; }

    // PKCE: verifier + challenge, plus state for CSRF protection.
    const verifier  = randomString(64);
    const challenge = base64UrlEncode(await sha256(verifier));
    const state     = randomString(24);

    sessionStorage.setItem("pkce_code_verifier", verifier);
    sessionStorage.setItem("oauth_state", state);

    // Identity Domains authorize endpoint (/oauth2/v1/authorize).
    const authorizeUrl =
      authBase() + "/oauth2/v1/authorize" +
      "?client_id=" + encodeURIComponent(AUTH.clientId) +
      "&response_type=code" +
      "&scope=" + encodeURIComponent("openid profile email") +
      "&redirect_uri=" + encodeURIComponent(AUTH.redirectUri) +
      "&state=" + encodeURIComponent(state) +
      "&code_challenge=" + encodeURIComponent(challenge) +
      "&code_challenge_method=S256";

    window.location.href = authorizeUrl;
  }

  function startLogout() {
    if (!AUTH) { setListStatus("Auth config not loaded yet."); return; }

    const idToken = sessionStorage.getItem("id_token");

    // Clear local session first.
    ["id_token", "access_token", "refresh_token", "expires_in",
     "token_received_at", "pkce_code_verifier", "oauth_state"]
      .forEach(k => sessionStorage.removeItem(k));

    setUiEnabled(false);
    updateAuthButtons();
    setListStatus("Signed out.");

    // Identity Domains logout endpoint (/oauth2/v1/userlogout).
    const postLogout = window.location.origin + window.location.pathname;
    const logoutUrl =
      authBase() + "/oauth2/v1/userlogout" +
      "?post_logout_redirect_uri=" + encodeURIComponent(postLogout) +
      (idToken ? "&id_token_hint=" + encodeURIComponent(idToken) : "");

    window.location.href = logoutUrl;
  }

  function startSignup() {
    if (!AUTH || !AUTH.signupProfileId) {
      setListStatus("Self-registration is not configured.");
      return;
    }
    // OCI's stock sign-in page won't render the self-registration link even with
    // show_on_login_page=true, so link straight to the hosted signup form.
    // Open in a NEW tab so the app stays put (register there, then sign in here).
    const signupUrl =
      authBase() + "/ui/v1/signup?profileid=" + encodeURIComponent(AUTH.signupProfileId);
    window.open(signupUrl, "_blank", "noopener");
  }

  // ===================== State ======================
  let notes = [];
  let selectedId = null;

  // ===================== Elements ===================
  const elNotes      = document.getElementById("notes");
  const elTitle      = document.getElementById("title");
  const elNote       = document.getElementById("note");
  const elStatus     = document.getElementById("status");
  const elListStatus = document.getElementById("listStatus");

  const modal        = document.getElementById("newModal");
  const modalTitle   = document.getElementById("modalTitle");
  const modalNote    = document.getElementById("modalNote");
  const modalStatus  = document.getElementById("modalStatus");

  const busyOverlay  = document.getElementById("busyOverlay");

  // ===================== Busy State =================
  function setBusy(isBusy) {
    document.body.classList.toggle("busy", isBusy);
    busyOverlay.classList.toggle("active", isBusy);
  }

  // ===================== Helpers ====================
  async function api(path, method = "GET", body) {
    console.log(method, API_BASE_URL + path);
    const headers = { "Content-Type": "application/json" };

    // Send the ID token; API Gateway validates it and injects X-User-Sub.
    const token = sessionStorage.getItem("id_token");
    if (token) headers["Authorization"] = "Bearer " + token;

    const res = await fetch(API_BASE_URL + path, {
      method,
      headers,
      body: body ? JSON.stringify(body) : undefined
    });

    const text = await res.text();
    if (!res.ok) throw new Error(text || res.status);
    return text ? JSON.parse(text) : null;
  }

  function setStatus(msg)     { elStatus.textContent = msg || ""; }
  function setListStatus(msg) { elListStatus.textContent = msg || ""; }

  // ===================== CRUD =======================
  async function loadNotes() {
    setBusy(true);
    setListStatus("Loading...");
    try {
      const res = await api("/notes");
      notes = res.items || [];
      renderNotes();
      setListStatus(`Loaded ${notes.length} note(s)`);
    } catch (e) {
      setListStatus("Error loading notes: " + e.message);
    } finally {
      setBusy(false);
    }
  }

  async function loadNote(id) {
    setBusy(true);
    setStatus("Loading note...");
    try {
      const n = await api(`/notes/${id}`);
      elTitle.value = n.title || "";
      elNote.value  = n.note || "";
      selectedId = id;
      renderNotes();
      setStatus("Loaded note");
    } catch (e) {
      setStatus("Error loading note: " + e.message);
    } finally {
      setBusy(false);
    }
  }

  async function saveNote() {
    const title = elTitle.value.trim();
    const note  = elNote.value || "";
    if (!title) { setStatus("Title is required"); return; }

    setBusy(true);
    try {
      if (selectedId) {
        await api(`/notes/${selectedId}`, "PUT", { title, note });
        setStatus("Updated note");
      } else {
        const res = await api("/notes", "POST", { title, note });
        selectedId = res.id;
        setStatus("Created note");
      }
      await loadNotes();
    } catch (e) {
      setStatus("Error saving note: " + e.message);
    } finally {
      setBusy(false);
    }
  }

  async function deleteNote() {
    if (!selectedId) { setStatus("Select a note to delete"); return; }
    if (!confirm("Delete this note?")) return;

    setBusy(true);
    try {
      await api(`/notes/${selectedId}`, "DELETE");
      selectedId = null;
      elTitle.value = "";
      elNote.value  = "";
      await loadNotes();
      setStatus("Deleted note");
    } catch (e) {
      setStatus("Error deleting note: " + e.message);
    } finally {
      setBusy(false);
    }
  }

  function renderNotes() {
    elNotes.innerHTML = "";
    notes.forEach(n => {
      const d = document.createElement("div");
      d.className = "note" + (n.id === selectedId ? " active" : "");
      d.textContent = n.title || "(untitled)";
      d.addEventListener("click", () => loadNote(n.id));
      elNotes.appendChild(d);
    });

    if (notes.length === 0) {
      const empty = document.createElement("div");
      empty.className = "status";
      empty.textContent = isAuthenticated()
        ? "No notes yet. Click New to create one."
        : "Please sign in to view notes.";
      elNotes.appendChild(empty);
    }
  }

  // ===================== Modal ======================
  function openModal() {
    modalTitle.value = "";
    modalNote.value = "";
    modalStatus.textContent = "";
    modal.style.display = "flex";
    setTimeout(() => modalTitle.focus(), 0);
  }

  function closeModal() { modal.style.display = "none"; }

  async function createFromModal() {
    const title = modalTitle.value.trim();
    const note  = modalNote.value || "";
    if (!title) { modalStatus.textContent = "Title is required"; return; }

    setBusy(true);
    modalStatus.textContent = "Creating...";
    try {
      const res = await api("/notes", "POST", { title, note });
      selectedId = res.id;
      elTitle.value = title;
      elNote.value  = note;
      closeModal();
      await loadNotes();
      setStatus("Created note");
    } catch (e) {
      modalStatus.textContent = "Error creating note: " + e.message;
    } finally {
      setBusy(false);
    }
  }

  modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener("keydown", (e) => {
    if (modal.style.display === "flex" && e.key === "Escape") closeModal();
  });

  // ===================== Wiring =====================
  function requireAuth(fn, statusFn) {
    return () => {
      if (!isAuthenticated()) { (statusFn || setListStatus)("Please sign in to continue."); return; }
      fn();
    };
  }

  document.getElementById("btnRefresh").addEventListener("click", requireAuth(loadNotes));
  document.getElementById("btnNew").addEventListener("click", requireAuth(openModal));
  document.getElementById("btnSave").addEventListener("click", requireAuth(saveNote, setStatus));
  document.getElementById("btnDelete").addEventListener("click", requireAuth(deleteNote, setStatus));
  document.getElementById("btnModalCancel").addEventListener("click", closeModal);
  document.getElementById("btnModalCreate").addEventListener("click",
    requireAuth(createFromModal, (m) => { modalStatus.textContent = m; }));

  // Auth chooser modal — "Sign in" opens a Sign In / Create Account chooser.
  const authModal = document.getElementById("authModal");
  function openAuthModal() {
    // If self-registration isn't configured, skip the chooser and sign in directly.
    if (!AUTH || !AUTH.signupProfileId) {
      setListStatus("Redirecting to sign-in...");
      startLogin().catch(e => setListStatus("Login error: " + e.message));
      return;
    }
    authModal.style.display = "flex";
  }
  function closeAuthModal() { authModal.style.display = "none"; }

  document.getElementById("btnLogin").addEventListener("click", openAuthModal);
  document.getElementById("authSignIn").addEventListener("click", () => {
    closeAuthModal();
    setListStatus("Redirecting to sign-in...");
    startLogin().catch(e => setListStatus("Login error: " + e.message));
  });
  document.getElementById("authCreate").addEventListener("click", () => {
    closeAuthModal();
    setListStatus("Redirecting to account creation...");
    startSignup();
  });
  document.getElementById("authCancel").addEventListener("click", closeAuthModal);
  authModal.addEventListener("click", (e) => { if (e.target === authModal) closeAuthModal(); });
  document.addEventListener("keydown", (e) => {
    if (authModal.style.display === "flex" && e.key === "Escape") closeAuthModal();
  });

  document.getElementById("btnLogout").addEventListener("click", () => {
    setListStatus("Signing out...");
    startLogout();
  });

  // ===================== Cold-start probe ===========
  // Once a minute, quietly time a GET /notes round-trip (only while signed in).
  // Silent — no busy overlay, no re-render — so it never disturbs the demo.
  const elProbe = document.getElementById("probe");
  window.__probes = [];
  let probeCount = 0;

  async function probeNotes() {
    if (!isAuthenticated()) return; // authenticated endpoint; skip when logged out
    const started = performance.now();
    const stamp   = new Date().toLocaleTimeString();
    try {
      const res = await fetch(API_BASE_URL + "/notes", {
        cache: "no-store",
        headers: { "Authorization": "Bearer " + sessionStorage.getItem("id_token") }
      });
      await res.text();
      const ms = Math.round(performance.now() - started);
      probeCount++;
      window.__probes.push({ n: probeCount, at: stamp, ms, status: res.status });
      console.log(`probe #${probeCount} ${stamp}  GET /notes  ${res.status}  ${ms} ms`);
      if (elProbe) elProbe.textContent = `probe #${probeCount} · ${ms} ms · ${stamp}`;
    } catch (e) {
      const ms = Math.round(performance.now() - started);
      console.log(`probe #${probeCount + 1} ${stamp}  GET /notes  FAILED  ${ms} ms  ${e.message}`);
      if (elProbe) elProbe.textContent = `probe · error · ${stamp}`;
    }
  }

  // ===================== Init =======================
  (async function init() {
    // Lock everything by default until we confirm a session.
    setUiEnabled(false);
    setListStatus("Please sign in to continue.");
    renderNotes();

    try {
      await loadAuthConfig();
      updateAuthButtons();

      if (!isAuthenticated()) return; // stay locked until sign-in

      setUiEnabled(true);
      await loadNotes();
      setInterval(probeNotes, PROBE_INTERVAL_MS);
    } catch (e) {
      setListStatus("Auth init error: " + e.message);
    }
  })();
</script>

</body>
</html>
